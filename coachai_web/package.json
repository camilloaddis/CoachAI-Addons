{
  "name": "coachai-web",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-build.mjs && vite build && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "dev": "vite",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node build/server.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "import:history": "node build/storage/import-cli.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "27.4.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
